# Hugo build cache
/.hugo_cache/
/resources/

# Hugo output — deployed by the pages workflow, kept out of the tree
# so PR diffs stay signal-only.
/public/
.hugo_build.lock

# The agentscope demo is recorded at build time by `agentscope capture` (3.4 MiB
# of vector frames), never committed.
/static/img/agentscope-demo.svg
/static/img/agentscope-demo.webm
/bin/
